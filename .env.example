# --- Django ---
SECRET_KEY=troque-por-uma-cadeia-aleatoria-longa
DEBUG=0
ALLOWED_HOSTS=maesegura.energisa.co.mz,maesegura.wooneya.co.mz,localhost
CSRF_TRUSTED_ORIGINS=https://maesegura.energisa.co.mz,https://maesegura.wooneya.co.mz
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=maesegura
POSTGRES_USER=maesegura
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Regras do produto ---
# 1 = nenhuma resposta clínica é servida sem validação humana registada.
# Mantenha sempre a 1 em ensaio e em produção.
EXIGIR_VALIDACAO_CLINICA=1
# Camada LLM opcional. O assistente é de recuperação; manter a 0.
LLM_ACTIVO=0

# --- Protecção anti-robô ---
# Cloudflare Turnstile (opcional). Sem estas chaves, o desafio não aparece e
# as restantes camadas continuam activas. Ver DEPLOY.md para as obter.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
